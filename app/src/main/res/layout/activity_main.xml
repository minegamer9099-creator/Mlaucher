<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/coloros_wallpaper">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="42dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/clockHeader"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OCT 13 TUE"
                android:textColor="#DDEBEEFF"
                android:textSize="12sp"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="10:00"
                android:textColor="#FFF7F7FF"
                android:textSize="76sp"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:letterSpacing="-0.06" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/homeViewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/pageDots"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/dockContainer"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/dock_background" />

        <View
            android:id="@+id/drawerHandle"
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/gesture_handle"
            android:contentDescription="Open app drawer" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="42dp"
        android:paddingBottom="20dp"
        android:background="@drawable/drawer_background"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All apps"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp"
            android:paddingBottom="16dp" />
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="⌕   Search apps"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#CFFFFFFF"
            android:textSize="15sp"
            android:background="@drawable/search_background" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="18dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />
        <TextView
            android:id="@+id/closeDrawerButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="Close"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:background="@drawable/chip_background" />
    </LinearLayout>
</FrameLayout>
