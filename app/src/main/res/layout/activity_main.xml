<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17202B">

    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wallpaper_scrim" />

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="30dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">
            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:41"
                android:textColor="#FFFFFFFF"
                android:textSize="54sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="-0.04" />
            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="Monday, 9 November"
                android:textColor="#E8FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Your day, at a glance"
                android:textColor="#DFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/homeViewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/pageDots"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/dockContainer"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/dock_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/drawerButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="All apps  ⌃"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:background="@drawable/chip_background" />
            <TextView
                android:id="@+id/fluidCloudButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Fluid Cloud"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:background="@drawable/chip_background" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="42dp"
        android:paddingBottom="20dp"
        android:background="@drawable/drawer_background"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All apps"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp"
            android:paddingBottom="16dp" />
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="⌕   Search apps"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#CFFFFFFF"
            android:textSize="15sp"
            android:background="@drawable/search_background" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="18dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />
        <TextView
            android:id="@+id/closeDrawerButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="Close"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:background="@drawable/chip_background" />
    </LinearLayout>
</FrameLayout>
